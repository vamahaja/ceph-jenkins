@Library('ceph-jenkins') _

pipeline {
    agent none

    options {
        // Keep the last 20 builds
        buildDiscarder(logRotator(numToKeepStr: "20"))

        // Do not checkout code automatically
        skipDefaultCheckout()

        // Timestamps in console output
        timestamps()

        // Colorize console output
        ansiColor("xterm")
    }

    stages {
        stage("Checkout and Build Binary") {
            agent {
                node {
                    label "ceph-build-fedora39-agent"
                }
            }

            stages {
                stage("Checkout Repositories") {
                    steps {
                        script {
                            ceph.initEnv()
                            artifacts.initEnv()
                        }

                        dir("${env.SHARED_WS}") {
                            checkout scm
                        }

                        script {
                            if (params.PUBLISH_ARTIFACTS) {
                                pulp.checkoutProject()
                            }
                        }
                    }
                }

                stage("Checkout Ceph Repository") {
                    steps {
                        script {
                            ceph.checkoutRepo()
                        }
                    }
                }

                stage("Build Binary") {
                    steps {
                        script {
                            ceph.buildBinary()
                        }
                    }
                }
            }
        }

        stage("Build Artifacts") {
            steps {
                script {
                    artifacts.buildSelected()
                }
            }
        }

        stage("Trigger Ceph Container Image Pipeline") {
            when {
                expression {
                    return params.BUILD_OCI_IMAGES
                }
            }

            agent {
                node {
                    label "ceph-build-fedora39-agent"
                }
            }

            steps {
                script {
                    echo "Triggering sample-ceph-container-pipeline ..."
                    build(
                        job: "sample-ceph-container-pipeline",
                        parameters: [
                            string(name: "CEPH_BRANCH", value: params.CEPH_BRANCH),
                            string(name: "SHA1", value: env.SHA1),
                            string(name: "VERSION", value: env.VERSION),
                            string(name: "DISTRO", value: params.DISTRO),
                            string(name: "ARCH", value: params.ARCH),
                            string(name: "FLAVOR", value: params.FLAVOR)
                        ],
                        wait: true,
                        propagate: true
                    )
                }
            }
        }
    }

    post {
        always {
            node("ceph-build-fedora39-agent") {
                script {
                    // May run before ceph.initEnv(); never NPE on SHARED_WS.
                    def sharedWs = ceph.resolveSharedWorkspace()
                    ws(sharedWs) {
                        if (fileExists("artifacts")) {
                            echo "Archiving RPMs and DEBs ..."
                            archiveArtifacts(
                                artifacts: "artifacts/**", allowEmptyArchive: true
                            )
                        }

                        sh "LC_ALL=C find '${sharedWs}' -depth -name '*[^[:print:]]*' -exec rm -rf {} + || true"

                        echo "Cleaning up shared workspace ${sharedWs} ..."
                        cleanWs(disableDeferredWipeout: true, deleteDirs: true)
                    }
                }
            }
        }
    }
}
