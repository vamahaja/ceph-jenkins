FROM registry.fedoraproject.org/fedora:45

# Define Build Arguments for UID/GID matching
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USER_NAME=jenkins

# Install all required RPM build tools and pipeline dependencies.
# Fedora 45 ships Java 25 (java-21-openjdk was removed in Fedora 44).
# The controller image is jenkins/jenkins:lts-jdk25, which agents may run.
RUN dnf install --allowerasing -y \
    sudo \
    java-25-openjdk-devel \
    git \
    rsync \
    which \
    rpm-build \
    dnf-plugins-core \
    yum-utils \
    python3-devel \
    python3-pip \
    python3-setuptools \
    git \
    gcc \
    gcc-c++ \
    make \
    cmake \
    cpio \
    jq \
    curl \
    wget \
    xz \
    tar \
    gzip && \
    dnf clean all

# Create the Jenkins user and group to match the host
RUN groupadd -g ${GROUP_ID} ${USER_NAME} || true && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m ${USER_NAME} && \
    echo "${USER_NAME} ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# Nix flakes for Stage 1 shared make-dist via flake packaging shell
COPY install-nix.sh /tmp/install-nix.sh
RUN chmod +x /tmp/install-nix.sh && \
    NIX_CHOWN_USER=${USER_NAME} /tmp/install-nix.sh && \
    rm -f /tmp/install-nix.sh
ENV PATH="/nix/var/nix/profiles/default/bin:${PATH}"

# Set up the working directory and ownership.
# OpenShift assigns a random UID: home must be traversable (not mode 700) so the
# shared-workspace PVC mounted at /workspace is reachable.
WORKDIR /home/${USER_NAME}
RUN chown -R ${USER_NAME}:${USER_NAME} /home/${USER_NAME} && \
    chmod 755 /home/${USER_NAME}
# Remoting launcher for OpenShift (pod command: jenkins-agent). Two files only;
# the distro image stays the base. Podman keeps CMD bash and does not run this.
COPY --from=docker.io/jenkins/inbound-agent:latest-jdk25 /usr/local/bin/jenkins-agent /usr/local/bin/jenkins-agent
COPY --from=docker.io/jenkins/inbound-agent:latest-jdk25 /usr/share/jenkins/agent.jar /usr/share/jenkins/agent.jar

# Switch to the non-root user
USER ${USER_NAME}

# Podman attach keeps this shell as PID 1. OpenShift overrides command with jenkins-agent.
CMD ["/bin/bash"]
