# Base Fedora 39 image
FROM registry.fedoraproject.org/fedora:39

# Build Arguments
ARG AGENT_UID=1000
ARG AGENT_GID=1001
ARG AGENT_USER=jenkins
ARG AGENT_GROUP=jenkins-bridge

# Install Core Dependencies
RUN dnf install -y \
    java-21-openjdk-devel \
    git \
    which \
    && dnf clean all

# Create User and Group
RUN groupadd -g ${AGENT_GID} ${AGENT_GROUP} && \
    useradd -u ${AGENT_UID} -g ${AGENT_GID} -m -s /bin/bash ${AGENT_USER}

# Set Up Workspace
WORKDIR /home/${AGENT_USER}
RUN mkdir -p /home/${AGENT_USER}/workspace && \
    chown -R ${AGENT_USER}:${AGENT_GROUP} /home/${AGENT_USER} && \
    chmod 755 /home/${AGENT_USER}

# Remoting launcher for OpenShift (pod command: jenkins-agent). Two files only.
# Podman keeps CMD bash and does not run this entrypoint.
COPY --from=docker.io/jenkins/inbound-agent:latest /usr/local/bin/jenkins-agent /usr/local/bin/jenkins-agent
COPY --from=docker.io/jenkins/inbound-agent:latest /usr/share/jenkins/agent.jar /usr/share/jenkins/agent.jar

# Final Configuration
USER ${AGENT_USER}

# Podman attach keeps this shell as PID 1. OpenShift overrides command with jenkins-agent.
CMD ["/bin/bash"]

# Seed job description labels
LABEL description="Jenkins Seed Job Agent for Pipelines" \
      base_image="fedora:39" \
      purpose="Job DSL processing"
