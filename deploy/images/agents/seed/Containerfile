# Alpine inbound agent: Java 25, git, bash, jenkins (uid 1000), jenkins-agent, and agent.jar.
# Job DSL Groovy runs on the controller. This image only checks out the repo and
# stays connected. Podman remoteFs is /home/jenkins and expects uid 1000.
FROM docker.io/jenkins/inbound-agent:alpine-jdk25

USER root

# git is used by the seed checkout and teuthology_trigger_ci. bash is PID 1 for
# the Podman attach connector. OpenShift assigns a random UID, so home must be
# traversable (not mode 700) and the workspace mount point must exist.
RUN apk add --no-cache git bash \
    && mkdir -p /home/jenkins/workspace \
    && chown -R jenkins:jenkins /home/jenkins \
    && chmod 755 /home/jenkins

USER jenkins
WORKDIR /home/jenkins

# Podman attach keeps this shell as PID 1. An entrypoint of jenkins-agent exits
# because that connector does not set JENKINS_SECRET. OpenShift overrides
# command with jenkins-agent, which this base image already provides.
ENTRYPOINT []
CMD ["/bin/bash"]

LABEL description="Jenkins Seed Job Agent for Pipelines" \
      base_image="jenkins/inbound-agent:alpine-jdk25" \
      purpose="Job DSL checkout"
