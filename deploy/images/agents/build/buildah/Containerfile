FROM quay.io/buildah/stable:latest

# Define Build Arguments for UID/GID matching
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USER_NAME=jenkins

# quay.io/buildah/stable is Fedora-based (currently F45+); Java 21 is not packaged there
RUN dnf install --allowerasing -y java-25-openjdk-devel podman && \
    dnf clean all

# Create the Jenkins user and group (buildah image may already use UID 1000)
RUN groupadd -g ${GROUP_ID} ${USER_NAME} || true && \
    if id -u ${USER_NAME} >/dev/null 2>&1; then \
      CURRENT_UID="$(id -u ${USER_NAME})" && \
      if [ "${CURRENT_UID}" != "${USER_ID}" ]; then \
        echo "User ${USER_NAME} already exists with UID ${CURRENT_UID}, expected ${USER_ID}" >&2; \
        exit 1; \
      fi && \
      usermod -g ${GROUP_ID} -d /home/${USER_NAME} -m ${USER_NAME}; \
    elif getent passwd ${USER_ID} >/dev/null 2>&1; then \
      EXISTING="$(getent passwd ${USER_ID} | cut -d: -f1)" && \
      usermod -l ${USER_NAME} "${EXISTING}" && \
      usermod -g ${GROUP_ID} -d /home/${USER_NAME} -m ${USER_NAME}; \
    else \
      useradd -u ${USER_ID} -g ${GROUP_ID} -m ${USER_NAME}; \
    fi && \
    ACTUAL="$(getent passwd ${USER_NAME})" && \
    echo "${ACTUAL}" | cut -d: -f3 | grep -qx "${USER_ID}" && \
    echo "${ACTUAL}" | cut -d: -f4 | grep -qx "${GROUP_ID}"

# Set root permissions for the Jenkins user
RUN echo "${USER_NAME} ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/${USER_NAME} && \
    chmod 440 /etc/sudoers.d/${USER_NAME}

# Set up the working directory and ownership
# OpenShift random UID needs /home/jenkins traversable for the shared-workspace PVC.
WORKDIR /home/${USER_NAME}
RUN chown -R ${USER_NAME}:${USER_NAME} /home/${USER_NAME} && \
    chmod 755 /home/${USER_NAME}

# Remoting launcher for OpenShift (pod command: jenkins-agent). Two files only;
# the distro image stays the base. Podman keeps CMD bash and does not run this.
COPY --from=docker.io/jenkins/inbound-agent:latest /usr/local/bin/jenkins-agent /usr/local/bin/jenkins-agent
COPY --from=docker.io/jenkins/inbound-agent:latest /usr/share/jenkins/agent.jar /usr/share/jenkins/agent.jar

# Switch to the non-root user
USER ${USER_NAME}

# Podman attach keeps this shell as PID 1. OpenShift overrides command with jenkins-agent.
CMD ["/bin/bash"]
